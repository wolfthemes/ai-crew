# Set default behavior to automatically normalize line endings
* text=auto

# Explicit line endings for common files
*.php text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.sh  text eol=lf

# Binary files - don't touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ttf binary
*.woff binary
*.woff2 binary

